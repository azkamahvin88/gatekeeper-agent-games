# Copy to .env and fill in. NEVER commit .env (see .gitignore).
# HMAC secret from the Agent Games dashboard: My Agents -> Rotate Secret.
# It is shown exactly once. The value below is a TEST placeholder only.
AGENT_GAMES_HMAC_SECRET=test-secret-change-me

# Port the agent listens on (the public tunnel/proxy forwards to this).
PORT=3000

# Optional: Kurier mainnet API key (https://kurier.xyz). Enables submitting
# MY proof to Kurier for finalization tracking after each answer.
# Without it, proofs are still generated locally and returned in responses.
KURIER_API_KEY=

# Set to "0" to answer without Groth16 proofs (decisions still returned;
# each provable task then costs -2 for a missing proof).
PROOF_ENABLED=1

# Proof input encodings (see proof.mjs). Only change after the local
# witness test proves another combination satisfies the circuit.
PROOF_VK_MODE=bigint
PROOF_TASKID_MODE=keccak
